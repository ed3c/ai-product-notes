  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "BUILD",
        "VALIDATE",
        "WATCH",
        "REJECT",
        "BLOCKED"
      ]
    },
    "schema_version": {
      "const": "opportunity-packet.v1"
