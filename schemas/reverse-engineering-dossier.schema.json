{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-product-notes/schemas/reverse-engineering-dossier.schema.json",
  "title": "Source-constrained reverse-engineering dossier",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dossier_id", "target", "source_subject", "user_context", "workflow", "mechanisms", "capabilities", "business", "riskiest_assumptions", "mvp", "lineage", "gates", "open_evidence_gaps", "decision", "authority_ceiling", "non_claims", "dossier_digest"],
  "properties": {
    "schema_version": {"const": "reverse-engineering-dossier@1"},
    "dossier_id": {"type": "string", "pattern": "^dossier:[a-z0-9][a-z0-9._:-]{1,191}$"},
    "decision": {"enum": ["VALIDATE", "WATCH", "BLOCKED", "REJECT"]},
    "authority_ceiling": {"const": "VALIDATION_DESIGN_ONLY"},
    "target": {"type": "object"},
    "source_subject": {"type": "object"},
    "user_context": {"type": "object"},
    "workflow": {"type": "array", "minItems": 3},
    "mechanisms": {"type": "array", "minItems": 1},
    "capabilities": {"type": "array", "minItems": 1},
    "business": {"type": "object"},
    "riskiest_assumptions": {"type": "array", "minItems": 1},
    "mvp": {"type": "object"},
    "lineage": {"type": "object"},
    "gates": {"type": "object"},
    "open_evidence_gaps": {"type": "array", "minItems": 1},
    "non_claims": {"type": "array", "minItems": 1},
    "dossier_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
