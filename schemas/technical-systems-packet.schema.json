{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-product-notes/schemas/technical-systems-packet.schema.json",
  "title": "Technical systems packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "packet_id", "source_subject", "authority_ceiling", "decision",
    "boundaries", "capabilities", "dependency_edges", "substitutions", "evals",
    "mvp_slice", "nonfunctional_evidence", "upstream_unknown_claims",
    "upstream_unresolved_contradictions", "evidence_state", "non_claims", "packet_digest"
  ],
  "properties": {
    "schema_version": {"const": "technical-systems-packet@1"},
    "packet_id": {"type": "string", "minLength": 3},
    "source_subject": {"type": "object"},
    "authority_ceiling": {"const": "TECHNICAL_DESIGN_ONLY"},
    "decision": {"const": "VALIDATE"},
    "boundaries": {"type": "object"},
    "capabilities": {"type": "array", "minItems": 1},
    "dependency_edges": {"type": "array"},
    "substitutions": {"type": "array"},
    "evals": {"type": "array", "minItems": 5},
    "mvp_slice": {"type": "object"},
    "nonfunctional_evidence": {"type": "object"},
    "upstream_unknown_claims": {"type": "array", "minItems": 1},
    "upstream_unresolved_contradictions": {"type": "array", "minItems": 1},
    "evidence_state": {
      "type": "object",
      "required": ["design", "implementation", "runtime", "user", "paid", "legal"],
      "properties": {
        "design": {"const": "PASS"},
        "implementation": {"const": "ABSENT"},
        "runtime": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_EXERCISED"]},
        "user": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_EXERCISED"]},
        "paid": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_EXERCISED"]},
        "legal": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_EXERCISED"]}
      }
    },
    "non_claims": {"type": "array", "minItems": 1},
    "packet_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
